// EATF-MultiRoot v0.2 architecture — rebuilt 2026-08-09 (referee gate 10: the
// previous figure depicted the v0.1 pipeline without the oracle or mutants).
// Strict B&W: black on white, no fills, square corners.
digraph EATFMultiRoot {
  rankdir=TB;
  node [shape=box, style=solid, color=black, fontcolor=black, fontname="Helvetica", fontsize=10];
  edge [color=black, fontname="Helvetica", fontsize=9, arrowsize=0.7];

  subgraph cluster_plan {
    label="Case plans"; color=black; fontname="Helvetica"; fontsize=10;
    seeds  [label="case_plan.json\n10 reviewed seed scenarios"];
    mutgen [label="generate_mutants.py  (v0.2)\n25 typed mutation operators"];
    mplan  [label="case_plan_mutants.json\n192 derived-fault cases"];
  }

  oracle [label="spec_oracle.py  (v0.2)\nderives every expected verdict\nfrom the declarative policy"];

  subgraph cluster_gen {
    label="Corpus construction (Python)"; color=black; fontname="Helvetica"; fontsize=10;
    gen    [label="build_eatf_corpus.py"];
    sign   [label="eatf-sign (Node.js,\nvendored EATF substrate)"];
    pkgs   [label="Signed .aep evidence packages\n22 reviewed + 705 mutant"];
  }

  subgraph cluster_ver {
    label="Verification (Python + vendored Node.js)"; color=black; fontname="Helvetica"; fontsize=10;
    verify [label="eatf-verify (Node.js)\npackage layer: signature,\ncanonical form, timestamp,\nreceipt integrity"];
    overlay[label="eatf_policy_overlay.py\nmulti-root policy layer:\nissuer trust, broker assurance,\nrevocation age, scope\nand algorithm policy"];
  }

  runner [label="run_evaluation.py\ncompares verdicts against\nthe derived expectations"];
  res    [label="results: JSON / CSV / Markdown\n+ artifact manifest (SHA-256)"];

  seeds -> gen;
  seeds -> mutgen -> mplan -> gen;
  seeds -> oracle [style=dashed];
  mplan -> oracle [style=dashed];
  gen -> sign -> pkgs -> verify;
  verify -> overlay [label="package verdict\n+ metadata"];
  overlay -> runner [label="accept / reject /\nindeterminate + reasons"];
  oracle -> runner [style=dashed, label="expected\nverdicts"];
  runner -> res;
}
